#!/bin/bash
# =============================================================================
# pre-push hook for shared-packages
# =============================================================================
#
# This hook runs before pushing to ensure packages are published.
# It prompts the user to publish if there are unpublished changes.
#
# =============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
PUBLISH_SCRIPT="$ROOT_DIR/scripts/publish-local.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check if running in interactive terminal
is_interactive() {
  [[ -t 0 && -t 1 ]]
}

# Only check on push to main
while read local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == *"refs/heads/main"* ]]; then
    echo ""
    echo -e "${BLUE}📦 Checking shared-packages before push to main...${NC}"
    echo ""

    # Run check and capture both exit code and output
    check_output=$("$PUBLISH_SCRIPT" --check 2>&1) || check_exit_code=$?
    check_exit_code=${check_exit_code:-0}

    # Exit code 0 = all up to date, exit code 1 = needs publishing
    # Other exit codes = error
    if [[ $check_exit_code -eq 0 ]]; then
      echo -e "${GREEN}✓${NC} All packages are published and up to date"
    elif [[ $check_exit_code -eq 1 ]]; then
      echo -e "${YELLOW}⚠${NC} Some packages need to be published"

      # Check if we're in interactive mode
      if ! is_interactive; then
        echo -e "${RED}✗${NC} Not in interactive terminal. Please publish packages manually:"
        echo "  cd $ROOT_DIR && ./scripts/publish-local.sh patch"
        exit 1
      fi

      echo ""
      echo "Options:"
      echo "  1) Publish now (recommended)"
      echo "  2) Skip and push anyway"
      echo "  3) Abort push"
      echo ""
      read -p "Choice [1/2/3]: " choice </dev/tty

      case $choice in
        1)
          echo ""
          "$PUBLISH_SCRIPT"

          # Check if there are uncommitted changes from publishing
          if [[ -n $(git status --porcelain packages/*/package.json) ]]; then
            echo ""
            echo -e "${YELLOW}⚠${NC} Package versions were updated. Please commit and push again:"
            echo "  git add packages/*/package.json"
            echo "  git commit -m 'chore: release packages'"
            echo "  git push"
            exit 1
          fi

          # Check for unpushed tags
          unpushed_tags=$(git tag -l '@caffeinebounce/*' --no-merged origin/main 2>/dev/null | wc -l | tr -d ' ')
          if [[ "$unpushed_tags" -gt 0 ]]; then
            echo ""
            echo -e "${YELLOW}⚠${NC} Don't forget to push tags after push completes:"
            echo "  git push --tags"
          fi
          ;;
        2)
          echo -e "${YELLOW}⚠${NC} Skipping publish. Consumer CI may fail if packages aren't published."
          ;;
        3)
          echo -e "${RED}✗${NC} Push aborted"
          exit 1
          ;;
        *)
          echo -e "${RED}✗${NC} Invalid choice. Push aborted."
          exit 1
          ;;
      esac
    else
      # Some other error occurred during check
      echo -e "${RED}✗${NC} Error checking package status:"
      echo "$check_output"
      echo ""
      echo "You can skip this check with: git push --no-verify"
      exit 1
    fi
  fi
done

exit 0
