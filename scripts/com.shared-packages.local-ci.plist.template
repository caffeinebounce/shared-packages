<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caffeinebounce.shared-packages.local-ci</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "__ENV_FILE__"; set +a; cd "__REPO_DIR__"; exec /usr/bin/env python3 scripts/local_ci_runner.py --repo "__REPO_DIR__" --state-dir "__STATE_DIR__"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/runner.stderr.log</string>
</dict>
</plist>
