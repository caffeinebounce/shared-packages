{
  "name": "shared-packages",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test --output-logs=errors-only",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --write . && turbo run lint",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "publish:local": "./scripts/publish-local.sh",
    "publish:patch": "./scripts/publish-local.sh patch",
    "publish:minor": "./scripts/publish-local.sh minor",
    "publish:major": "./scripts/publish-local.sh major",
    "publish:check": "./scripts/publish-local.sh --check",
    "prepare": "husky || true",
    "setup-hooks": "scripts/setup-hooks.sh"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@changesets/cli": "^2.30.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "jsdom": "^26.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "yarn@4.12.0"
}
