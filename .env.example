# GitHub token for package registry authentication.
# Required scopes: read:packages for installs, write:packages for publishing.
#
# OPTION 1 (Recommended): Use your password manager
# Retrieve the token from your team's approved secret store.
#
# OPTION 2: Use GitHub CLI token
# If you're authenticated with `gh auth login`, use:
#   export GITHUB_TOKEN=$(gh auth token)
#
# OPTION 3: Personal Access Token
# Create a classic PAT at https://github.com/settings/tokens with scopes:
#   - read:packages
#   - write:packages
GITHUB_TOKEN=replace_with_github_token

# Email Configuration
# Provider: resend | smtp | mock
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com

# Resend (production)
RESEND_API_KEY=re_your_api_key_here

# SMTP (local development with Mailpit)
# Run: docker-compose up mailpit
# View emails: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
