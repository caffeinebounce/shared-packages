# GitHub token for package registry authentication
# Required scopes: read:packages, write:packages
#
# OPTION 1 (Recommended): Use GitHub CLI token
# If you're authenticated with `gh auth login`, use:
#   export GITHUB_TOKEN=$(gh auth token)
#
# OPTION 2: Personal Access Token
# Create a classic PAT at https://github.com/settings/tokens with scopes:
#   - read:packages
#   - write:packages
# Then set it here:
GITHUB_TOKEN=ghp_your_personal_access_token_here

# NOTE: The gh CLI token (gho_*) is automatically refreshed and has correct scopes
# if you authenticated with: gh auth login --scopes "read:packages,write:packages"
