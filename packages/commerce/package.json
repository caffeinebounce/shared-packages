{
  "name": "@caffeinebounce/commerce",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinebounce/shared-packages.git",
    "directory": "packages/commerce"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "yarn run -T vitest run",
    "test:watch": "yarn run -T vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "stripe": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stripe": "^17.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.5.0",
    "@stripe/stripe-js": "^5.8.0",
    "lucide-react": "^0.577.0"
  },
  "license": "UNLICENSED"
}
