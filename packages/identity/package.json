{
  "name": "@caffeinebounce/identity",
  "version": "0.11.3",
  "description": "Authentication components and handlers for Caffeine Bounce projects",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "yarn run -T vitest run",
    "test:watch": "yarn run -T vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinebounce/shared-packages.git",
    "directory": "packages/identity"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    }
  },
  "dependencies": {
    "@caffeinebounce/logger": "^0.9.130",
    "@caffeinebounce/shared-utils": "^0.7.133",
    "@caffeinebounce/ui": "^0.58.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.49.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "sonner": "^2.0.7",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
