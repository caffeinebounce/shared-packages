{
  "name": "@caffeinebounce/email",
  "version": "0.6.80",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinebounce/shared-packages.git",
    "directory": "packages/email"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:email": "email dev --dir src/templates",
    "test": "yarn run -T vitest run",
    "test:watch": "yarn run -T vitest",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@react-email/components": "^1.0.1",
    "nodemailer": "^7.0.13",
    "resend": "^6.5.2"
  }
}
