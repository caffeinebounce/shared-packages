{
  "name": "@caffeinebounce/scheduling",
  "version": "0.1.0",
  "description": "Framework-agnostic scheduling kernel: availability/slot engine, Microsoft Graph + Google calendar clients, ICS generation, and token encryption. Powers the TCC Scheduler.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.mjs",
      "require": "./dist/engine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.mjs",
      "require": "./dist/crypto.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.mjs",
      "require": "./dist/ports.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.mjs",
      "require": "./dist/graph.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "import": "./dist/google.mjs",
      "require": "./dist/google.js"
    },
    "./ics": {
      "types": "./dist/ics.d.ts",
      "import": "./dist/ics.mjs",
      "require": "./dist/ics.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinebounce/shared-packages.git",
    "directory": "packages/scheduling"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "yarn run -T vitest run",
    "test:watch": "yarn run -T vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
